{
  "name": "sable-edit",
  "version": "0.1.0",
  "private": true,
  "description": "Drop-in SVG element editor. No runtime dependencies; Node is for development only.",
  "type": "module",
  "main": "dist/sable-edit.esm.js",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node scripts/build.js",
    "serve": "npm run build && serve . -l 8080",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"test/unit/**/*.test.js\"",
    "test:e2e": "npm run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "esbuild": "^0.25.0",
    "serve": "^14.2.0"
  }
}
